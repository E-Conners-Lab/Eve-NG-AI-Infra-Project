# EVE-NG API
EVE_NG_HOST=
EVE_NG_USERNAME=
EVE_NG_PASSWORD=

# NetBox API
NETBOX_URL=http://localhost:8000
NETBOX_TOKEN=

# Device credentials (used by pyATS/Scrapli for SSH)
DEVICE_USERNAME=
DEVICE_PASSWORD=
DEVICE_ENABLE_PASSWORD=

# FortiGate credentials (if different from network devices)
FORTIGATE_USERNAME=
FORTIGATE_PASSWORD=

# Lab owner contact info (used for NetBox contact assignment)
LAB_OWNER_NAME=
LAB_OWNER_EMAIL=

# Telegram bot (agent notifications)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Cloud-AWS hybrid (only required if cloud_aws site is in use) ──
# Path to the cloned cloud-devops-pipeline repo (used by `make sync-aws-outputs`)
AWS_REPO=
# AWS Secrets Manager ARN of the IPsec PSK (Terraform output: psk_secret_arn).
# Read by scripts/push_configs._inject_aws_psk at push time.
AWS_VPN_PSK_SECRET_ARN=
# Public EIP of the strongSwan EC2 (Terraform output: strongswan_eip)
AWS_STRONGSWAN_EIP=
# This host's public IP, used as the AWS-side security-group ingress source
ONPREM_PUBLIC_IP=
