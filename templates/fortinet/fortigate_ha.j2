### FortiGate HA Configuration
### Generated from spec — do not edit manually
###
config system global
    set hostname "{{ hostname }}"
end

config system ha
    set mode a-p
    set group-id {{ ha_group_id }}
    set group-name "{{ site_key }}-ha-cluster"
    set priority {{ ha_priority }}
    set hbdev "port3" 50
    set session-pickup enable
    set override disable
{% if mgmt_ip %}
    set ha-mgmt-status enable
    config ha-mgmt-interfaces
        edit 1
            set interface "port6"
            set gateway {{ mgmt_gateway }}
        next
    end
{% endif %}
end

{% for iface in interfaces %}
config system interface
    edit "{{ iface.name }}"
{% if iface.get('ipv4') %}
        set mode static
        set ip {{ ip_no_mask(iface.ipv4) }} {{ cidr_to_subnet(ip_mask(iface.ipv4) | int) }}
{% endif %}
        set allowaccess ping https ssh
        set description "{{ iface.description | default('') }}"
    next
end

{% endfor %}
{% if mgmt_ip %}
config system interface
    edit "port6"
        set mode static
        set ip {{ mgmt_ip }} 255.255.252.0
        set allowaccess ping https ssh
        set description "Management"
    next
end

{% endif %}
{% for zone in zones %}
config system zone
    edit "{{ zone.name }}"
        set intrazone allow
        set description "{{ zone.type }} zone"
{% if zone.get('interfaces') %}
        set interface{% for zif in zone.interfaces %} "{{ zif }}"{% endfor %}

{% endif %}
    next
end

{% endfor %}
{% for policy in policies %}
config firewall policy
    edit {{ loop.index }}
        set name "{{ policy.name }}"
        set srcintf "{{ policy.source_zone }}"
        set dstintf "{{ policy.destination_zone }}"
        set srcaddr "all"
        set dstaddr "all"
{% set action_map = {'allow': 'accept', 'deny': 'deny', 'inspect': 'accept'} %}
        set action {{ action_map.get(policy.action, policy.action) }}
{% if policy.get('services') %}
{% set svc_map = {'tcp/443': 'HTTPS', 'tcp/80': 'HTTP', 'tcp/22': 'SSH', 'icmp': 'ALL_ICMP', 'tcp/53': 'DNS', 'udp/53': 'DNS'} %}
        set service{% for svc in policy.services %} "{{ svc_map.get(svc, svc) }}"{% endfor %}

{% endif %}
        set schedule "always"
        set logtraffic all
    next
end

{% endfor %}
